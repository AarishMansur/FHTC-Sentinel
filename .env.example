# Copy to .env and fill values. Never commit the real .env.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fhtc

JWT_SECRET=replace_me_with_a_long_random_string_min_20_chars
CRON_SECRET=replace_me_with_another_long_random_string

ESRI_BASE_URL=https://services.arcgis.com/your_org/arcgis/rest/services/JJM_FHTC_Districts/FeatureServer/0
ESRI_PAGE_SIZE=100
ESRI_RETRIES=3
ESRI_TIMEOUT_MS=30000
ESRI_CONCURRENCY=3

ESRI_FIELD_STATE=STATE
ESRI_FIELD_CODE=DIST_CODE
ESRI_FIELD_NAME=DIST_NAME

ESRI_FIELD_2023_TOTAL=VILLAGES_2023
ESRI_FIELD_2023_ZERO=ZERO_FHTC_2023
ESRI_FIELD_2023_FULL=FULL_FHTC_2023
ESRI_FIELD_2024_TOTAL=VILLAGES_2024
ESRI_FIELD_2024_ZERO=ZERO_FHTC_2024
ESRI_FIELD_2024_FULL=FULL_FHTC_2024
ESRI_FIELD_2025_TOTAL=VILLAGES_2025
ESRI_FIELD_2025_ZERO=ZERO_FHTC_2025
ESRI_FIELD_2025_FULL=FULL_FHTC_2025

# Optional intermediate bucket fields
ESRI_FIELD_2025_BUCKET_0_25=
ESRI_FIELD_2025_BUCKET_25_50=
ESRI_FIELD_2025_BUCKET_50_75=
ESRI_FIELD_2025_BUCKET_75_100=

SYNC_URL=http://localhost:3000
SYNC_STATE=Rajasthan
SYNC_LOCK_HOURS=20
